{
 "actions": [],
 "allow_import": 1,
 "autoname": "naming_series:",
 "doctype": "DocType",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "POS-ORD-.YYYY.-",
   "hidden": 1
  },
  {
   "fieldname": "order_details_section",
   "fieldtype": "Section Break",
   "label": "Order Details",
   "icon": "fa fa-file-text"
  },
  {
   "fieldname": "order_type",
   "fieldtype": "Select",
   "label": "Order Type",
   "options": "\nDine-In\nTakeaway",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "default": "Dine-In"
  },
  {
   "depends_on": "eval:doc.order_type === 'Dine-In'",
   "fieldname": "table_no",
   "fieldtype": "Link",
   "label": "Table No",
   "options": "Restaurant Table",
   "mandatory_depends_on": "eval:doc.order_type === 'Dine-In'"
  },
  {
   "fieldname": "takeaway_token",
   "fieldtype": "Data",
   "label": "Takeaway Token",
   "read_only": 1,
   "depends_on": "eval:doc.order_type === 'Takeaway'"
  },
  {
   "fieldname": "customer_section",
   "fieldtype": "Section Break",
   "label": "Customer Details"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer"
  },
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "read_only": 1
  },
  {
   "fieldname": "mobile_no",
   "fieldtype": "Data",
   "label": "Mobile Number"
  },
  {
   "fieldname": "items_section",
   "fieldtype": "Section Break",
   "label": "Items",
   "icon": "fa fa-shopping-cart"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "POS Order Item",
   "reqd": 1
  },
  {
   "fieldname": "totals_section",
   "fieldtype": "Section Break",
   "label": "Totals & Taxes"
  },
  {
   "fieldname": "total_qty",
   "fieldtype": "Float",
   "label": "Total Quantity",
   "read_only": 1
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Float",
   "label": "Total Amount",
   "read_only": 1
  },
  {
   "fieldname": "discount_amount",
   "fieldtype": "Float",
   "label": "Discount Amount",
   "default": "0"
  },
  {
   "fieldname": "service_charge",
   "fieldtype": "Float",
   "label": "Service Charge",
   "default": "0",
   "depends_on": "eval:doc.order_type === 'Dine-In'"
  },
  {
   "fieldname": "tax_total",
   "fieldtype": "Float",
   "label": "Tax Total",
   "read_only": 1
  },
  {
   "fieldname": "grand_total",
   "fieldtype": "Float",
   "label": "Grand Total",
   "read_only": 1
  },
  {
   "fieldname": "kitchen_status_section",
   "fieldtype": "Section Break",
   "label": "Kitchen & Order Status",
   "icon": "fa fa-clock-o"
  },
  {
   "fieldname": "order_status",
   "fieldtype": "Select",
   "label": "Order Status",
   "options": "\nPending\nPreparing\nReady\nServed\nPicked Up\nCancelled",
   "default": "Pending",
   "allow_on_submit": 1,
   "in_list_view": 1,
   "search_index": 1,
   "reqd": 1
  },
  {
   "fieldname": "kitchen_status",
   "fieldtype": "Select",
   "label": "Kitchen Status",
   "options": "\nPending\nIn Progress\nReady\nServed",
   "default": "Pending",
   "allow_on_submit": 1,
   "depends_on": "eval:doc.order_type === 'Dine-In'"
  },
  {
   "fieldname": "payment_section",
   "fieldtype": "Section Break",
   "label": "Payment Details",
   "icon": "fa fa-credit-card"
  },
  {
   "fieldname": "billing_mode",
   "fieldtype": "Select",
   "label": "Billing Mode",
   "options": "\nPay Now\nPay Later",
   "default": "Pay Later"
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment Status",
   "options": "\nUnpaid\nPaid",
   "allow_on_submit": 1,
   "default": "Unpaid",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "billing_invoice",
   "fieldtype": "Link",
   "label": "Billing Invoice",
   "options": "Billing Invoice",
   "allow_on_submit": 1,
   "read_only": 1
  },
  {
   "fieldname": "payment_method",
   "fieldtype": "Select",
   "label": "Payment Method",
   "options": "\nCash\nCard\nUPI\nWallet\nNet Banking\nCredit"
  },
  {
   "fieldname": "paid_amount",
   "fieldtype": "Float",
   "label": "Paid Amount",
   "default": "0"
  },
  {
   "fieldname": "change_amount",
   "fieldtype": "Float",
   "label": "Change Amount",
   "read_only": 1
  },
  {
   "fieldname": "transaction_id",
   "fieldtype": "Data",
   "label": "Transaction ID"
  },
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "default": "Today",
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "posting_time",
   "fieldtype": "Time",
   "label": "Posting Time"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks / Notes"
  }
 ],
 "icon": "fa fa-shopping-cart",
 "is_submittable": 1,
 "module": "Billing",
 "name": "POS Order",
 "owner": "Administrator",
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "All",
   "share": 1,
   "write": 1
  },
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1
  }
 ],
  "search_fields": "order_type,table_no,takeaway_token,order_status,billing_invoice,payment_status",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "title_field": "order_type"
}
